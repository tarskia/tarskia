{
  "name": "@tarskia/diagram-worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "tarskia": "./dist/cli.js"
  },
  "files": [
    "assets",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../scripts/build-semantics.mjs && rm -rf dist && tsup src/cli.ts --format esm --platform node --target node22 --out-dir dist && node scripts/copy-cli-assets.mjs",
    "typecheck": "node ../scripts/build-semantics.mjs && tsc -p tsconfig.json --noEmit",
    "test": "node ../scripts/build-semantics.mjs && vitest run",
    "build-diagram": "node dist/cli.js build"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.162.0",
    "@secretlint/core": "13.0.7",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "ajv": "^8.18.0",
    "js-yaml": "^4.1.0",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@tarskia/diagram-semantics": "0.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.17",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.3"
  }
}
